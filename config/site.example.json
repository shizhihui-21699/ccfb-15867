{
  "site_domains": [
    "example.gov.cn"
  ],
  "allowlist_domains": [
    "hm.baidu.com",
    "*.baidu.com",
    "*.bdstatic.com",
    "*.cnzz.com",
    "*.google-analytics.com",
    "*.googletagmanager.com",
    "*.bootcdn.net",
    "*.staticfile.org",
    "*.qq.com",
    "*.gtimg.com",
    "*.weixin.qq.com"
  ],
  "database": {
    "dsn": "mysql:host=127.0.0.1;dbname=cms;charset=utf8mb4",
    "user": "readonly",
    "password": "CHANGE_ME",
    "sample_rows": 200,
    "exclude_tables": ["*_log", "*_logs", "session*", "sys_*"]
  },
  "http": {
    "enabled": true,
    "max_urls_per_site": 25,
    "timeout": 8,
    "cloak_similarity_threshold": 0.82
  },
  "report": {
    "min_level": "low"
  }
}
